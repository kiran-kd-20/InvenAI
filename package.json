{
  "name": "invenai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx lib/scripts/seed.ts",
    "db:reset": "prisma migrate reset",
    "test": "node -e \"console.log('Tests configured. Run: npm run test:api')\"",
    "test:api": "tsx tests/comprehensive.test.ts",
    "test:forecasting": "tsx tests/forecasting.test.ts",
    "api:test": "node -e \"require('./tests/comprehensive.test.ts').InvenAITestSuite.runComprehensiveTests()\"",
    "build:production": "npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
